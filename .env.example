# Local `supabase start` demo keys (safe to commit as placeholders).
# Replace with the remote project keys after factory-new-app provisioning.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=replace-with-anon-or-publishable-key

# Local E2E only — never commit a remote service role key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
E2E_TEST_SECRET=change-me
