# Local `supabase start` demo keys (safe to commit as placeholders).
# Replace with the remote project keys after factory-new-app provisioning.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Local E2E only — never commit a remote service role key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
E2E_TEST_SECRET=change-me

# Server-only secrets for the optional embedded Cursor assistant.
# Generate a 32-byte base64 value for AGENT_CREDENTIAL_ENCRYPTION_KEY and a
# separate high-entropy value for AGENT_CAPABILITY_SECRET. Never expose either
# as a NUXT_PUBLIC_ variable.
AGENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
AGENT_CAPABILITY_SECRET=replace-with-high-entropy-secret
AGENT_ALLOWED_ORIGIN=http://localhost:3000
