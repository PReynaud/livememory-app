{
  "name": "livememory-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:vercel": "nuxt build --preset=vercel",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:check-latest-migration": "node scripts/check-latest-migration-on-existing-data.mjs",
    "db:types": "supabase gen types typescript --local --schema public > app/types/database.types.ts",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/supabase": "2.0.9",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/supabase-js": "^2.117.3",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^3.21.0",
    "@playwright/test": "^1.64.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "supabase": "^2.76.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@11.13.1",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,vue}": "eslint --fix"
  }
}
