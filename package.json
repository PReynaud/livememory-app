{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:vercel": "nuxt build --preset=vercel",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > app/types/database.types.ts",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/supabase": "2.0.9",
    "@pinia/nuxt": "^0.11.3",
    "@vite-pwa/nuxt": "1.1.1",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^3.21.0",
    "@playwright/test": "^1.58.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.7.0",
    "happy-dom": "^20.0.0",
    "supabase": "^2.76.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@11.13.1"
}
